<%# used for other recipes in foudn_recipes.html.erb %>
<%# class recipe-card used for tests %>
<div class="recipe-card flex no-shrink w-500 border shadow container font mt-md mx-15">
  <%# link to full recipe with query params to lately retrieve the previous search %>
  <%= link_to recipe_path(recipe, query: params[:query]), class: 'no-text-deco w-fit h-fit' do %>
    <img src="<%= recipe.image %>" alt="" class='w-80 h-80'>
    <div>
        <p class='mt-md mx-15'><%= recipe.title %></p>
        <p class='mt-md mx-15'>Rating: <%= recipe.rating %></p>
        <p class='mt-md mx-15'>Total time: <%= recipe.total_time %> min</p>
        <p class='mx-15 underline'>Let's check it out!</p>
    <% end %>
  </div>
</div>
