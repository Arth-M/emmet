<button class="cursor-pointer text-[10px] px-2 py-1 rounded-md border border-slate-700 text-slate-400
                 hover:border-sky-500/60 hover:text-sky-400 transition-colors
                 data-[active=true]:border-sky-500 data-[active=true]:text-sky-400 data-[active=true]:bg-sky-500/10"
          data-action="click->pav-map#filterByWasteType"
          data-waste-type=<%= infos[:waste_type] %>
          data-active=<%= infos[:active] %>>
    <%= infos[:waste_type].capitalize %>
  </button>
