<%# used in show.html.erb %>
<div class="flex w-90 mx-auto border shadow container font mt-md">
    <img src="<%= recipe.image %>" alt="" class='w-80 h-80'>
    <div>
        <p class='inline mx-15'><%= recipe.title %></p>
        <p class='inline mx-15'>Preparation time: <%= recipe.prep_time %> min</p>
        <p class='inline mx-15'>Cooking time: <%= recipe.cook_time %> min</p>
        <% if params[:query].present? %>
        <%# link back to search with query params to retrieve the previous search %>
          <%= link_to "Back to search",
            found_recipes_path(query: params[:query]),
            class: "inline button no-text-deco mx-15",
            data: { turbo_frame: "react-like" } %>
        <% else %>
        <%# link to main page - no query %>
          <%= link_to "Back to main page",
            root_path,
            class: "inline button no-text-deco mx-15",
            data: { turbo_frame: "react-like" } %>
        <% end %>
    <div class="grid-2">
      <ul class="mt-lg">
        <%# search through recipe_ingredient(joint table) to find right quantity for ingredients %>
          <% recipe.recipe_ingredients.each do |recipe_ingred| %>
            <% if recipe_ingred.quantity != '0' %>
              <li><%= recipe_ingred.quantity %>
              <%= recipe_ingred.ingredient.name %></li>
            <% else %>
              <li><%= recipe_ingred.ingredient.name.upcase_first %></li>
            <% end %>
          <% end %>
      </ul>
      <div>
        <p>Rating: <%= recipe.rating %></p>
        <p>Category: <%= recipe.category.name %></p>
        <p>Author: <%= recipe.author %></p>
      </div>
    </div>
  </div>
</div>
