<%
  fill = pav.fill_percent
  bar_color  = fill > 85 ? "bg-red-500"    :  "bg-amber-600"
  text_color = fill > 85 ? "text-red-400"  :  "text-amber-600"
%>
<li id="pav-item-<%= pav.id %>"
    class="card p-3 cursor-pointer
            transition-all duration-150 hover:bg-mist-300!
            data-[active=true]:bg-mist-300! data-[active=true]:ring-1 data-[active=true]:ring-mist-400"
    data-action="click->pav-map#selectPav"
    data-pav-id="<%= pav.id %>"
    data-pav-lat="<%= pav.lat %>"
    data-pav-lng="<%= pav.lng %>"
    data-pav-name="<%= pav.name %>"
    data-active="false"
    >

  <div class="flex items-center justify-between mb-2">
    <span class="text-sm font-medium truncate max-w-[180px]"><%= pav.name %></span>
    <% if pav.open_incident %>
      <span class="text-amber-400 text-sm ml-2 shrink-0">⚠</span>
    <% end %>
  </div>

  <div class="flex items-center space-x-2">
    <div class="flex-1 h-1.5 bg-mist-500 rounded-xl overflow-hidden">
      <div class="h-full rounded-l-xl <%= bar_color %>" style="width:<%= [fill, 100].min %>%"></div>
    </div>
    <span class="text-xs tabular-nums <%= text_color %> min-w-[34px] text-end"><%= fill %>%</span>
  </div>

</li>
