<%# ─── Incidents récents (global) ────────────────────────────────────────── %>
  <section class="bg-slate-900 border border-slate-800 overflow-hidden py-4">
    <%= render partial: "shared/back_home"  %>
    <div class="px-4 py-2.5 border-b border-slate-800 flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
      <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-widest">Incidents récents</h2>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-xs">
        <thead>
          <tr>
            <th class="text-left text-[10px] font-semibold text-slate-500 uppercase tracking-wider px-4 py-2.5 border-b border-slate-800 bg-slate-900">Type</th>
            <th class="text-left text-[10px] font-semibold text-slate-500 uppercase tracking-wider px-3 py-2.5 border-b border-slate-800 bg-slate-900">PAV</th>
            <th class="text-left text-[10px] font-semibold text-slate-500 uppercase tracking-wider px-3 py-2.5 border-b border-slate-800 bg-slate-900">Date</th>
            <th class="text-left text-[10px] font-semibold text-slate-500 uppercase tracking-wider px-3 py-2.5 border-b border-slate-800 bg-slate-900">Statut</th>
            <th class="text-right text-[10px] font-semibold text-slate-500 uppercase tracking-wider px-4 py-2.5 border-b border-slate-800 bg-slate-900">Délai</th>
          </tr>
        </thead>
        <tbody>
          <% @recent_incidents.each do |inc| %>
            <% border_open = inc.resolved ? "" : "border-l-2 border-amber-500/50" %>
            <tr class="border-b border-slate-800/60 hover:bg-slate-800/40 transition-colors <%= border_open %>">
              <td class="px-4 py-2.5">
                <span class="bg-slate-800 border border-slate-700/80 text-slate-300 rounded px-1.5 py-0.5 text-[10px] whitespace-nowrap">
                  <%= inc.incident_type.name %>
                </span>
              </td>
              <td class="px-3 py-2.5 text-slate-400 max-w-[140px]">
                <span class="block truncate"><%= inc.event.location.name %></span>
              </td>
              <td class="px-3 py-2.5 text-slate-500 tabular-nums whitespace-nowrap">
                <%= inc.event.occurred_at.strftime("%d/%m %H:%M") %>
              </td>
              <td class="px-3 py-2.5">
                <% if inc.resolved %>
                  <span class="inline-flex items-center gap-1.5 text-emerald-400">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0"></span>Résolu
                  </span>
                <% else %>
                  <span class="inline-flex items-center gap-1.5 text-amber-400">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse shrink-0"></span>Ouvert
                  </span>
                <% end %>
              </td>
              <td class="px-4 py-2.5 text-right tabular-nums text-slate-500">
                <% if inc.resolved && inc.respond_to?(:resolution_delay_hours) && inc.resolution_delay_hours %>
                  <%= inc.resolution_delay_hours.round(1) %>h
                <% else %>—<% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
