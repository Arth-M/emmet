<%# app/views/homes/index.html.erb %>
<%# CDN à ajouter dans <head> du layout :

%>

<%# pav-map js controller %>
<div class="min-h-screen bg-slate-950 text-slate-200 p-4 flex flex-col gap-3 w-full"
     data-controller="pav-map"
     data-pav-map-locations-value="<%= @locations_for_map %>">

  <%# ─── KPI BAR ─────────────────────────────────────────────────────────── %>
  <div class="flex flex-wrap space-x-3 space-y-1 justify-between">

    <%= link_to incidents_index_path do %>
      <div class="relative bg-slate-900 border border-slate-800 rounded-xl p-4 overflow-hidden">
        <div class="absolute top-0 inset-x-0 h-0.5 bg-amber-500 rounded-t-xl"></div>
        <p class="text-2xl font-bold text-amber-400 tabular-nums"><%= @open_incidents_count %></p>
        <p class="text-xs text-slate-500 uppercase tracking-widest mt-1">Incidents ouverts</p>
        <p class="text-2xl font-bold text-emerald-400 tabular-nums"><%= @resolution_rate %>%</p>
        <p class="text-xs text-slate-500 uppercase tracking-widest mt-1">Taux de résolution</p>
      </div>
    <% end %>

    <%= link_to sensors_index_path do %>
      <div class="relative bg-slate-900 border border-slate-800 rounded-xl p-4 overflow-hidden">
        <div class="absolute top-0 inset-x-0 h-0.5 bg-sky-500 rounded-t-xl"></div>
        <p class="text-2xl font-bold text-sky-400 tabular-nums"><%= @avg_fill %>%</p>
        <p class="text-xs text-slate-500 uppercase tracking-widest mt-1">Fill moyen</p>
      </div>
    <% end %>

    <%= link_to sensors_index_path do %>
      <div class="relative bg-slate-900 border border-slate-800 rounded-xl p-4 overflow-hidden">
        <div class="absolute top-0 inset-x-0 h-0.5 bg-rose-500 rounded-t-xl"></div>
        <p class="text-2xl font-bold text-rose-400 tabular-nums"><%= @critical_pavs_count %></p>
        <p class="text-xs text-slate-500 uppercase tracking-widest mt-1">PAV critiques</p>
        <p class="text-2xl font-bold text-rose-400 tabular-nums"><%= @moderate_critical_pavs_count %></p>
        <p class="text-xs text-slate-500 uppercase tracking-widest mt-1">PAV bientôt remplis</p>
      </div>

    <% end %>

  </div>

  <%# Filtre waste_type %>
<div class="px-2 pt-2 flex flex-wrap gap-1.5">
  <button class="text-[10px] px-2 py-1 rounded-md border border-slate-700 text-slate-400
                 hover:border-sky-500/60 hover:text-sky-400 transition-colors
                 data-[active=true]:border-sky-500 data-[active=true]:text-sky-400 data-[active=true]:bg-sky-500/10"
          data-action="click->pav-map#filterByWasteType"
          data-waste-type="all"
          data-active="true">
    Tous
  </button>
  <% @waste_types.each do |wt| %>
    <button class="text-[10px] px-2 py-1 rounded-md border border-slate-700 text-slate-400
                   hover:border-sky-500/60 hover:text-sky-400 transition-colors
                   data-[active=true]:border-sky-500 data-[active=true]:text-sky-400 data-[active=true]:bg-sky-500/10"
            data-action="click->pav-map#filterByWasteType"
            data-waste-type="<%= wt %>"
            data-active="false">
      <%= wt.capitalize %>
    </button>
  <% end %>
</div>

  <%# ─── MAIN GRID ─────────────────────────────────────────────────────────── %>
  <div class="grid grid-cols-1 lg:grid-cols-[1fr_300px] gap-3 flex-1">

    <%# ── Colonne gauche ───────────────────────────────────────────────────── %>
    <div class="flex flex-col gap-3">

      <%# Carte %>
      <section class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden flex flex-col h-[420px]">
        <div class="px-4 py-2.5 border-b border-slate-800 flex items-center gap-2 shrink-0">
          <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
          <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-widest">Carte des PAV</h2>
        </div>
        <div class="flex-1 min-h-0" data-pav-map-target="map"></div>
      </section>

      <%# Graphique + Incidents PAV %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 h-90">

        <%# Graphique fill %>
        <section class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden flex flex-col min-h-[220px]">
          <div class="px-4 py-2.5 border-b border-slate-800 flex items-center gap-2 shrink-0">
            <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
            <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-widest">Historique remplissage</h2>
            <span class="ml-auto text-xs text-slate-600 italic" data-pav-map-target="chartTitle">—</span>
          </div>
          <div class="flex-1 relative flex items-center justify-center p-3 min-h-0">
            <p class="text-slate-600 text-sm" data-pav-map-target="chartPlaceholder">
              Cliquez sur un PAV pour voir l'historique
            </p>
            <canvas class="hidden absolute inset-3" data-pav-map-target="fillChart"></canvas>
          </div>
        </section>

        <%# Incidents du PAV sélectionné %>
        <section class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden flex flex-col min-h-[220px]">
          <div class="px-4 py-2.5 border-b border-slate-800 flex items-center gap-2 shrink-0">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
            <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-widest">Incidents PAV</h2>
          </div>
          <div class="overflow-y-auto flex-1" data-pav-map-target="pavIncidents">
            <p class="text-slate-600 text-sm text-center py-8">Sélectionnez un PAV</p>
          </div>
        </section>

      </div>

    </div><%# /colonne gauche %>

    <%# ── Sidebar PAV critiques ────────────────────────────────────────────── %>
    <aside class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden flex flex-col">
      <div class="px-4 py-2.5 border-b border-slate-800 flex items-center gap-2 shrink-0">
        <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
        <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-widest">PAV à surveiller</h2>
        <span class="ml-auto bg-rose-500/20 text-rose-400 text-xs font-bold px-2 py-0.5 rounded-full border border-rose-500/30">
          <%= @critical_pavs_count +  @moderate_critical_pavs_count%>
        </span>
      </div>

      <ul class="overflow-y-auto p-2 gap-y-1.5">
        <% @critical_pavs.each do |pav| %>
          <%
            fill = pav.fill_percent
            bar_color  = fill > 85 ? "bg-rose-500"    : fill > 50 ? "bg-amber-500"    : "bg-emerald-500"
            text_color = fill > 85 ? "text-rose-400"  : fill > 50 ? "text-amber-400"  : "text-emerald-400"
          %>
          <li id="pav-item-<%= pav.id %>"
              class="bg-slate-800/60 border border-slate-700/50 rounded-lg p-3 cursor-pointer
                     transition-all duration-150 hover:border-sky-500/60 hover:bg-slate-800
                     data-[active=true]:border-sky-500/70 data-[active=true]:bg-slate-800 data-[active=true]:ring-1 data-[active=true]:ring-sky-500/30"
              data-action="click->pav-map#selectPav"
              data-pav-id="<%= pav.id %>"
              data-pav-lat="<%= pav.lat %>"
              data-pav-lng="<%= pav.lng %>"
              data-pav-name="<%= pav.name %>"
              data-active="false"
              >

            <div class="flex items-center justify-between mb-2">
              <span class="text-sm font-medium text-slate-200 truncate max-w-[180px]"><%= pav.name %></span>
              <% if pav.open_incident %>
                <span class="text-amber-400 text-sm animate-pulse ml-2 shrink-0">⚠</span>
              <% end %>
            </div>

            <div class="flex items-center gap-2">
              <div class="flex-1 h-1.5 bg-slate-700 rounded-full overflow-hidden">
                <div class="h-full rounded-full <%= bar_color %>" style="width:<%= [fill, 100].min %>%"></div>
              </div>
              <span class="text-xs tabular-nums <%= text_color %> min-w-[34px] text-right"><%= fill %>%</span>
            </div>

          </li>
        <% end %>

        <% @moderate_critical_pavs.each do |pav| %>
          <%
            fill = pav.fill_percent
            bar_color  = fill > 85 ? "bg-rose-500"    :  "bg-amber-500"
            text_color = fill > 85 ? "text-rose-400"  :  "text-amber-400"
          %>
          <li id="pav-item-<%= pav.id %>"
              class="bg-slate-800/60 border border-slate-700/50 rounded-lg p-3 cursor-pointer
                     transition-all duration-150 hover:border-sky-500/60 hover:bg-slate-800
                     data-[active=true]:border-sky-500/70 data-[active=true]:bg-slate-800 data-[active=true]:ring-1 data-[active=true]:ring-sky-500/30"
              data-action="click->pav-map#selectPav"
              data-pav-id="<%= pav.id %>"
              data-pav-lat="<%= pav.lat %>"
              data-pav-lng="<%= pav.lng %>"
              data-pav-name="<%= pav.name %>"
              data-active="false"
              >

            <div class="flex items-center justify-between mb-2">
              <span class="text-sm font-medium text-slate-200 truncate max-w-[180px]"><%= pav.name %></span>
              <% if pav.open_incident %>
                <span class="text-amber-400 text-sm animate-pulse ml-2 shrink-0">⚠</span>
              <% end %>
            </div>

            <div class="flex items-center gap-2">
              <div class="flex-1 h-1.5 bg-slate-700 rounded-full overflow-hidden">
                <div class="h-full rounded-full <%= bar_color %>" style="width:<%= [fill, 100].min %>"></div>
              </div>
              <span class="text-xs tabular-nums <%= text_color %> min-w-[34px] text-right"><%= fill %>%</span>
            </div>

          </li>
          <% end %>

        <% if @critical_pavs.empty? && @moderate_critical_pavs.empty? %>
          <li class="text-slate-500 text-sm text-center py-8">Aucun PAV critique.</li>
        <% end %>
      </ul>
    </aside>

  </div><%# /main-grid %>


</div><%# /dashboard %>

<%# Leaflet dark mode — uniquement les overrides impossibles en Tailwind %>
<style>
  .leaflet-container { background: #0f172a !important; }
  .leaflet-tile { filter: brightness(.55) saturate(.3) hue-rotate(190deg); }
  .leaflet-control-zoom a { background: #1e293b !important; color: #94a3b8 !important; border-color: #334155 !important; }
  .leaflet-popup-content-wrapper { background: #1e293b; border: 1px solid #334155; border-radius: 10px; color: #e2e8f0; }
  .leaflet-popup-tip { background: #1e293b; }
</style>
